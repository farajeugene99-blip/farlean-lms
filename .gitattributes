# Auto-detect text files and normalize line endings on checkout/commit
* text=auto

# Source code files - enforce LF line endings
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.rules text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.so binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
